# Local Postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Neon / hosted Postgres (use the -pooler host for serverless, keep sslmode=require):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Optional: AI assistant (hosted app only). A key saved in Settings wins over these.
# AI_API_KEY=sk-...
# AI_PROVIDER=openai        # openai | anthropic | gemini | openrouter | groq | custom
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
